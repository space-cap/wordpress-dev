# =================================================================
# 법무법인 파라딘 - Python 실시간 업무 자동화 환경변수 설정 예시
# =================================================================

# 1. Google Sheets API 설정
# 구글 드라이브에 생성한 스프레드시트의 파일 제목과 시트 탭 이름을 지정합니다.
GOOGLE_SHEET_TITLE="법무법인 파라딘 상담 현황"
GOOGLE_SHEET_TAB_NAME="실시간신청"

# 2. Slack Webhook 설정
# 슬랙 채널 알림을 받기 위한 Incoming Webhook URL을 입력합니다.
SLACK_WEBHOOK_URL="https://hooks.slack.com/services/your-slack-webhook-url"

# 3. 인증 키 파일 경로 (컨테이너 내부 기준)
GOOGLE_APPLICATION_CREDENTIALS="/app/credentials.json"
